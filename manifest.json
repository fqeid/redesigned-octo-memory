{
  "manifest_version": 3,
  "name": "Edge Tab Management POC",
  "version": "0.1.0",
  "description": "Discard background tabs by group, view URLs and tab status, and optionally report snapshots to Telegraf.",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "alarms", "storage"],
  "host_permissions": ["https://telegraf.example.invalid/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Tab Management", "default_popup": "popup.html" }
}
